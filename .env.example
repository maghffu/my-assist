# === Wajib ===
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token-from-botfather
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes
ALLOWED_CHAT_ID=123456789

# === AI Provider (Pilar 8) ===
# Untuk GLM Coding Plan (endpoint Anthropic-compatible):
#   ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   ANTHROPIC_MODEL=glm-4.6
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# === Opsional (ada default-nya) ===
N_CONTEXT=20
SOUL_PATH=soul.md
RUST_LOG=info

# === Web & Image (Pilar 10+12, Fase 5) ===
# Backend pencarian — saat ini: tavily (satu-satunya; brave/ddg menyusul kalau perlu)
SEARCH_PROVIDER=tavily
# Free tier ±1000 credit/bulan — daftar di tavily.com. Tanpa key, tool web_search
# balas pesan konfigurasi (bot tetap jalan normal).
TAVILY_API_KEY=tvly-your-key
# Timeout per request fetch_url (detik)
FETCH_TIMEOUT=30
# Timeout eksekusi per shell command (detik)
RUN_CMD_TIMEOUT=120
# Root path yang diizinkan utk read_file/write_file + cwd awal run_command,
# dipisah koma. run_command sendiri bebas cd/akses path lain (mode root).
WORK_ROOTS=/root/my-assist,/opt/hermes-lite,/opt/vault
# Timeout menunggu approval command berisiko via tombol Telegram (detik).
# Lewat waktu = otomatis batal. Tombol: ✅ sekali / 🔁 sesi ini / ❌ tolak.
CONFIRM_TIMEOUT=600
# Timeout generate_image — generasi Pollinations bisa lambat (detik)
IMAGE_TIMEOUT=60

# === OCR (Pilar 7) ===
# Bahasa Tesseract, multi dipisah + (eng+ind = Inggris+Indonesia)
OCR_LANG=eng+ind
# Path tessdata opsional — kosongkan utk default sistem (/usr/share/tesseract/tessdata)
# OCR_TESSDATA=/usr/share/tesseract/tessdata
# === Email PT (scripts/send_email.py) ===
# SMTP_USER=...
# SMTP_PASS=...
# DKIM_KEY_FILE=/opt/hermes-lite/keys/dkim_private.pem
